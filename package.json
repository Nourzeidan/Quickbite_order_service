{
  "name": "order-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "archiver": "tsx watch src/archiver.ts",
    "start:archiver": "node dist/archiver.js",
    "archive:once": "tsx src/archiver.ts --once",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/lib/knex/migrate-all.ts latest",
    "migrate:rollback": "tsx src/lib/knex/migrate-all.ts rollback",
    "migrate:archive": "tsx src/lib/knex/migrate-all.ts latest --archive",
    "migrate:make": "tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile src/lib/knex/knexfile.ts",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "tsyringe": "^4.10.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
