PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# must match core-service
ACCESS_SECRET=

# shards: one Postgres per region (country)
REGIONS=eg,ksa
DB_POOL_MAX=10
DB_MIGRATION_DIR=src/migrations
DB_MIGRATION_EXTENSION=ts
# pg_partman maintenance from the app (0 = off, e.g. when pg_partman_bgw runs it)
PARTMAN_MAINTENANCE_INTERVAL_MIN=60
IDEMPOTENCY_CLEANUP_INTERVAL_MIN=60

DB_eg_HOST=localhost
DB_eg_PORT=5432
DB_eg_USERNAME=postgres
DB_eg_PASSWORD=
DB_eg_NAME=order_service_eg

DB_ksa_HOST=localhost
DB_ksa_PORT=5432
DB_ksa_USERNAME=postgres
DB_ksa_PASSWORD=
DB_ksa_NAME=order_service_ksa

# archive clusters (required, Phase 5): same server locally, databases order_service_archive_<region>
ARCHIVE_DB_eg_HOST=
ARCHIVE_DB_eg_PORT=
ARCHIVE_DB_eg_USERNAME=
ARCHIVE_DB_eg_PASSWORD=
ARCHIVE_DB_eg_NAME=
ARCHIVE_DB_ksa_HOST=
ARCHIVE_DB_ksa_PORT=
ARCHIVE_DB_ksa_USERNAME=
ARCHIVE_DB_ksa_PASSWORD=
ARCHIVE_DB_ksa_NAME=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (inbound core events)
RABBITMQ_URL=amqp://order-service:<password>@localhost:5672/quickbite
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_CORE_EVENTS_QUEUE=order-service.core-events
RABBITMQ_CORE_EVENTS_BINDINGS=product.#,branch.#,restaurant.#,rbac.#
RABBITMQ_CORE_EVENTS_DLX=core.events.dlx
RABBITMQ_CORE_EVENTS_DLQ=order-service.core-events.dlq
RABBITMQ_PREFETCH=32

# core-service sync calls
CORE_SERVICE_BASE_URL=http://localhost:3000
CORE_INTERNAL_API_KEY=
CORE_TIMEOUT_MS=800

# orders
SERVICE_FEE_BPS=0
CUSTOMER_CANCEL_WINDOW_SEC=60

# Kashier v3 (Phase 2) — dashboard: Integrations -> API keys. Test and live keys differ.
KASHIER_BASE_URL=https://test-api.kashier.io
KASHIER_FEP_BASE_URL=https://test-fep.kashier.io
KASHIER_MERCHANT_ID=
# Authorization header (Secret Key)
KASHIER_SECRET_KEY=
# api-key header (Payment API Key)
KASHIER_API_KEY=
# HMAC key of x-kashier-signature — Kashier signs webhooks with the Payment API Key
KASHIER_WEBHOOK_SECRET=
# browser lands here after paying (cosmetic only). Kashier rejects localhost: must be a public URL
KASHIER_RETURN_URL=https://<your-tunnel>/api/payments/return
# public URL of POST /api/payments/webhook/kashier (ngrok / cloudflared in dev)
KASHIER_WEBHOOK_URL=https://<your-tunnel>/api/payments/webhook/kashier
KASHIER_TIMEOUT_MS=5000
# unit of data.amount in webhooks: major ("113.34") or minor (11334)
KASHIER_WEBHOOK_AMOUNT_UNIT=major
PAYMENT_SESSION_TIMEOUT_MIN=15
PAYMENT_SWEEP_INTERVAL_SEC=60
# unpaid orders are cancelled at session timeout + grace (a last-second payment can still land)
PAYMENT_SWEEP_GRACE_MIN=3
# a refund sent to Kashier with no webhook outcome after this long -> ALERT log
REFUND_STALE_ALERT_MIN=60

# deliveries & agents (Phase 3) — the offer worker (npm run worker)
OFFER_INTERVAL_SEC=10
# offer each ready order to the N nearest eligible agents; offers expire after OFFER_TTL_SEC and are re-sent
OFFER_TOP_N=3
OFFER_TTL_SEC=60
OFFER_BATCH=100
# agents within this distance of the branch, seen within AGENT_STALE_SEC (5 min)
ASSIGNMENT_RADIUS_METERS=5000
AGENT_STALE_SEC=300
# agent's share of the delivery fee: 8000 = 80%
AGENT_SHARE_BPS=8000

WS_HEARTBEAT_SEC=30

# archival (Phase 5) — npm run archiver
ARCHIVE_INTERVAL_MIN=60
ARCHIVE_WINDOW_UTC=0-5
ARCHIVE_BATCH_SIZE=500
ARCHIVE_MAX_BATCHES_PER_RUN=200
ARCHIVE_MIN_AGE_DAYS=30
ARCHIVE_STUCK_ALERT_DAYS=60
