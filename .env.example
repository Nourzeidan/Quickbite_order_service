PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# must match core-service
ACCESS_SECRET=

# shards: one Postgres per region (country)
REGIONS=eg,ksa
DB_POOL_MAX=10
DB_MIGRATION_DIR=src/migrations
DB_MIGRATION_EXTENSION=ts
# pg_partman maintenance from the app (0 = off, e.g. when pg_partman_bgw runs it)
PARTMAN_MAINTENANCE_INTERVAL_MIN=60
IDEMPOTENCY_CLEANUP_INTERVAL_MIN=60

DB_eg_HOST=localhost
DB_eg_PORT=5432
DB_eg_USERNAME=postgres
DB_eg_PASSWORD=
DB_eg_NAME=order_service_eg

DB_ksa_HOST=localhost
DB_ksa_PORT=5432
DB_ksa_USERNAME=postgres
DB_ksa_PASSWORD=
DB_ksa_NAME=order_service_ksa

# archive clusters (optional until Phase 7)
ARCHIVE_DB_eg_HOST=
ARCHIVE_DB_eg_PORT=
ARCHIVE_DB_eg_USERNAME=
ARCHIVE_DB_eg_PASSWORD=
ARCHIVE_DB_eg_NAME=
ARCHIVE_DB_ksa_HOST=
ARCHIVE_DB_ksa_PORT=
ARCHIVE_DB_ksa_USERNAME=
ARCHIVE_DB_ksa_PASSWORD=
ARCHIVE_DB_ksa_NAME=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (inbound core events)
RABBITMQ_URL=amqp://order-service:<password>@localhost:5672/quickbite
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_CORE_EVENTS_QUEUE=order-service.core-events
RABBITMQ_CORE_EVENTS_BINDINGS=product.#,branch.#,restaurant.#,rbac.#
RABBITMQ_CORE_EVENTS_DLX=core.events.dlx
RABBITMQ_CORE_EVENTS_DLQ=order-service.core-events.dlq
RABBITMQ_PREFETCH=32

# core-service sync calls
CORE_SERVICE_BASE_URL=http://localhost:3000
CORE_INTERNAL_API_KEY=
CORE_TIMEOUT_MS=800

# orders
SERVICE_FEE_BPS=0
CUSTOMER_CANCEL_WINDOW_SEC=60

WS_HEARTBEAT_SEC=30
